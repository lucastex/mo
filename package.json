{
  "name": "larmontessori",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "knowledge": "node scripts/build-knowledge.mjs",
    "dev": "node scripts/build-knowledge.mjs && eve dev",
    "build": "node scripts/build-knowledge.mjs && eve build",
    "start": "eve start",
    "dev:web": "next dev apps/web",
    "build:web": "next build apps/web",
    "dev:eve": "eve dev",
    "dev:all": "vercel dev --local",
    "dev:chat": "node scripts/build-knowledge.mjs && concurrently -k -n eve,web -c magenta,cyan \"eve dev --no-ui --no-default-extensions\" \"next dev apps/web --port 3000\""
  },
  "dependencies": {
